{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jqq-workflows-demo",
	"main": "./src/worker.ts",
	"account_id": "e9bc21da719562a3e45d77de7dd042de",
	"compatibility_date": "2026-06-05",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"workflows": [
		{
			"name": "demo-workflow",
			"binding": "MY_WORKFLOW",
			"class_name": "DemoWorkflow"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "PROGRESS_ROOM",
				"class_name": "ProgressRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ProgressRoom"]
		}
	]
}
